{% extends 'base.html.twig' %}

{% block title %}Auteur{% endblock %}

{% block body %}
    <h1>Auteur</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Pseudonyme</th>
                <td>{{ auteur.pseudonyme }}</td>
            </tr>
            <tr>
                <th>Biographie</th>
                <td>{{ auteur.biographie }}</td>
            </tr>
        </tbody>
    </table>

    <div class="barre-boutons">
        <a href="{{ path('app_auteur_index') }}" class="btn">Retour à la liste</a>
        <a href="{{ path('app_auteur_edit', {'id': auteur.id}) }}" class="btn btn-modifier">Modifier</a>
        <form method="post" action="{{ path('app_auteur_delete', {'id': auteur.id}) }}"
              onsubmit="return confirm('Supprimer l\'auteur « {{ auteur.pseudonyme|e('js') }} » ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ auteur.id) }}">
            <button class="btn btn-supprimer">Supprimer</button>
        </form>
    </div>
{% endblock %}
